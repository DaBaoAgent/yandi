{"total":386.9,"scenes":[{"s":0,"e":3.06,"type":"food-burst","text":""},{"s":3.06,"e":5.19,"type":"tea-medicine","text":""},{"s":5.19,"e":7.21,"type":"question","text":""},{"s":7.21,"e":10.13,"type":"not-wildman","text":""},{"s":10.13,"e":14.14,"type":"yandi-reveal","text":""},{"s":14.14,"e":16.16,"type":"story-card","text":""},{"s":16.16,"e":20.01,"type":"poison-counter","text":""},{"s":20.01,"e":21.37,"type":"myth","text":""},{"s":21.37,"e":25.61,"type":"bigger","text":""},{"s":25.61,"e":30.86,"type":"four-things","text":""},{"s":30.86,"e":32.38,"type":"one-man-four","text":""},{"s":32.3802,"e":34.888878,"text":"每一件事都够别的文明记几百年的","last":"都够别的文明记几百年的","type":"chapter","tag":"第一章","title":"教中国人种地"},{"s":34.888878,"e":38.069762000000004,"text":"在神农氏之前中国人吃什么打猎采集","last":"采集","type":"kinetic"},{"s":38.069762000000004,"e":42.5644,"text":"今天逮个兔子明天摘点野果子后天跟老虎打架输了就被老虎吃了","last":"就被老虎吃了","type":"kinetic"},{"s":42.604400000000005,"e":46.213798000000004,"text":"这种生活方式有个什么问题不稳定","last":"不稳定","type":"slam"},{"s":46.213798000000004,"e":50.453345,"text":"猎物多的时候吃撑猎物少的时候饿死遇到天灾全族团灭","last":"全族团灭","type":"kinetic"},{"s":50.453345,"e":55.13237,"text":"神农氏干了什么他发现有些植物的种子掉在地上第二年能长出新的植物来","last":"第二年能长出新的植物来","type":"kinetic"},{"s":55.13237,"e":58.135839000000004,"text":"而且这些植物的种子能吃于是他开始试","last":"于是他开始试","type":"q"},{"s":58.135839000000004,"e":60.985748,"text":"哪种植物的种子能吃哪种植物的果实能吃","last":"哪种植物的果实能吃","type":"q"},{"s":60.985748,"e":65.641122,"text":"哪种植物的根能吃他一种一种试试出来能吃的就大面积种植","last":"就大面积种植","type":"slam"},{"s":65.641122,"e":69.137721,"text":"这就是农业的起源你别觉得这有什么了不起的","last":"你别觉得这有什么了不起的","type":"slam"},{"s":69.137721,"e":71.797449,"text":"你想想从打猎采集到种地这中间差了什么","last":"这中间差了什么","type":"icon"},{"s":71.797449,"e":75.605181,"text":"差了一个文明打猎采集的人天天搬家跟着猎物跑","last":"跟着猎物跑","type":"slam"},{"s":75.605181,"e":80.333776,"text":"种地的人定居下来定居下来才能盖房子才能建村庄才能有时间琢磨别的事","last":"才能有时间琢磨别的事","type":"kinetic"},{"s":80.333776,"e":84.766156,"text":"而且种地能产粮食粮食能存存起来遇到灾年就不怕了","last":"遇到灾年就不怕了","type":"kinetic"},{"s":84.766156,"e":89.14763,"text":"人口就能增长人口增长了就能形成部落联盟就能形成国家","last":"就能形成国家","type":"slam"},{"s":89.14763,"e":93.748492,"text":"所以你看人类文明的起点不是什么石头工具不是什么火","last":"不是什么火","type":"slam"},{"s":93.748492,"e":97.567336,"text":"是农业而中国农业的起点就是神农氏","last":"就是神农氏","type":"slam"},{"s":97.567336,"e":100.23974426229509,"text":"他教会了中国人种五谷哪五谷稻黍稷麦菽","last":"菽","type":"list","items":["稻","黍","稷","麦","菽"]},{"s":100.23974426229509,"e":106.3324,"text":"就是大米黄米小米小麦大豆你今天吃的主食七千年前就是他定下来的","last":"七千年前就是他定下来的","type":"list","items":["大米","黄米","小米","小麦","大豆"]},{"s":106.3724,"e":113.076088,"text":"神农尝百草这个故事你们都听过但我要告诉你的是这个故事背后是人类历史上最早的药物学","last":"是人类历史上最早的药物学","type":"chapter","tag":"第二章","title":"尝百草"},{"s":113.076088,"e":115.721984,"text":"你想想在神农氏之前人生病了怎么办","last":"人生病了怎么办","type":"q"},{"s":115.721984,"e":119.083889,"text":"硬扛扛过去就活扛不过去就死没有药没有医生","last":"没有医生","type":"kinetic"},{"s":119.083889,"e":121.695159,"text":"神农氏干了什么他亲口尝各种植物","last":"他亲口尝各种植物","type":"icon"},{"s":121.695159,"e":124.98398,"text":"这个植物吃了什么感觉那个植物吃了有什么反应","last":"那个植物吃了有什么反应","type":"kinetic"},{"s":124.98398,"e":130.277653,"text":"他一种一种试有的植物吃了拉肚子有的植物吃了发烧有的植物吃了居然能止血","last":"有的植物吃了居然能止血","type":"kinetic"},{"s":130.277653,"e":134.79087299999998,"text":"他把这些全记下来了后来中国最早的药物学著作叫什么","last":"后来中国最早的药物学著作叫什么","type":"icon"},{"s":134.79087299999998,"e":137.45515899999998,"text":"神农本草经虽然这本书不是他写的是后人托名的","last":"是后人托名的","type":"icon"},{"s":137.45515899999998,"e":141.90586199999998,"text":"但它为什么叫神农因为神农就是中国医药学的源头","last":"因为神农就是中国医药学的源头","type":"q"},{"s":141.90586199999998,"e":146.1401,"text":"你想想这个场景一个七千年前的人蹲在草丛里把各种植物往嘴里塞","last":"把各种植物往嘴里塞","type":"kinetic"},{"s":146.1801,"e":149.32305,"text":"尝到毒的赶紧吐出来尝到有用的就记下来","last":"就记下来","type":"icon"},{"s":149.32305,"e":152.74613399999998,"text":"这是什么这是最早的临床实验而且他不光尝植物","last":"而且他不光尝植物","type":"slam"},{"s":152.74613399999998,"e":158.17989799999998,"text":"他还尝矿物尝动物中国古代的中药植物药动物药矿物药","last":"矿物药","type":"list","items":["植物药","动物药","矿物药"]},{"s":158.17989799999998,"e":160.8205,"text":"三大类这三大类的分类就是从神农开始的","last":"就是从神农开始的","type":"kinetic"},{"s":160.8605,"e":166.32715399999998,"text":"你今天生病去看中医中医给你开的方子追根溯源都是神农当年一口一口尝出来的","last":"都是神农当年一口一口尝出来的","type":"kinetic"},{"s":166.32715399999998,"e":167.421009,"text":"尝百草是找药","last":"尝百草是找药","type":"chapter","tag":"第三章","title":"发明医药"},{"s":167.421009,"e":171.43445599999998,"text":"但光有药不够你还得会治病神农氏还发明了针灸对就是你今天去中医馆扎的那个针","last":"就是你今天去中医馆扎的那个针","type":"icon"},{"s":171.43445599999998,"e":176.96246,"text":"传说神农氏发明了砭石就是用磨尖的石头扎在身上的某个位置能止痛","last":"能止痛","type":"kinetic"},{"s":176.96246,"e":182.436791,"text":"能治病后来砭石演变成了针灸针从石头到骨头从骨头到青铜从青铜到不锈钢","last":"从青铜到不锈钢","type":"list","items":["石头","骨头","青铜","不锈钢"]},{"s":182.436791,"e":185.08524193548388,"text":"但原理是一样的刺激穴位调节气血","last":"调节气血","type":"kinetic"},{"s":185.08524193548388,"e":190.04070000000002,"text":"你别觉得这是什么玄学世界卫生组织都承认针灸对某些症状有效","last":"世界卫生组织都承认针灸对某些症状有效","type":"kinetic"},{"s":190.0807,"e":193.61037399999998,"text":"而针灸的源头就是七千年前的神农氏他还教人们接生","last":"他还教人们接生","type":"icon"},{"s":193.61037399999998,"e":199.691689,"text":"传说他是妇产科的祖师爷你想想七千年前生孩子就是过鬼门关","last":"生孩子就是过鬼门关","type":"kinetic"},{"s":199.691689,"e":203.84914999999998,"text":"产妇死亡率极高神农氏教人们怎么接生怎么处理产后出血怎么照顾新生儿","last":"怎么照顾新生儿","type":"icon"},{"s":203.84914999999998,"e":206.192166,"text":"这又是一件救命的事","last":"这又是一件救命的事","type":"kinetic"},{"s":206.192166,"e":209.59114499999998,"text":"这个事你们肯定没想到神农氏还是中国最早的商业之父","last":"神农氏还是中国最早的商业之父","type":"chapter","tag":"第四章","title":"最早的市场"},{"s":209.59114499999998,"e":213.798265,"text":"他干了什么他规定了每天中午大家到一个地方来以物换物","last":"以物换物","type":"kinetic"},{"s":213.798265,"e":216.611281,"text":"你家多余的粮食换我家多余的陶器","last":"换我家多余的陶器","type":"kinetic"},{"s":216.611281,"e":220.192982,"text":"你家的兽皮换我家的石斧这就是中国最早的市场","last":"这就是中国最早的市场","type":"slam"},{"s":220.192982,"e":225.633095,"text":"日中为市你别觉得这有什么了不起的你想想在神农氏之前部落之间是怎么交换东西的","last":"部落之间是怎么交换东西的","type":"kinetic"},{"s":225.633095,"e":228.52182499999998,"text":"打仗我看上你的东西了我带人来抢","last":"我带人来抢","type":"kinetic"},{"s":228.52182499999998,"e":233.992755,"text":"神农氏说别打了咱们中午在广场上你拿你多余的我拿我多余的咱们换","last":"咱们换","type":"kinetic"},{"s":233.992755,"e":237.547857,"text":"公平交易谁也别抢谁这就是商业的起源","last":"这就是商业的起源","type":"slam"},{"s":237.547857,"e":241.21477299999998,"text":"也是和平的起源你看市场这个东西从一开始就不是什么资本主义的发明","last":"从一开始就不是什么资本主义的发明","type":"slam"},{"s":241.21477299999998,"e":244.20080000000002,"text":"它是中国人为了避免打仗想出来的办法","last":"想出来的办法","type":"icon"},{"s":244.2408,"e":249.99506799999997,"text":"你今天去菜市场买菜去超市买东西追根溯源都是神农氏定下的规矩日中为市","last":"都是神农氏定下的规矩日中为市","type":"slam"},{"s":249.99506799999997,"e":251.64506799999998,"text":"以物换物说到炎帝","last":"说到炎帝","type":"chapter","tag":"第五章","title":"炎帝与黄帝"},{"s":251.64506799999998,"e":254.895975,"text":"就绕不开黄帝神话里说炎帝和黄帝是兄弟","last":"炎帝和黄帝是兄弟","type":"kinetic"},{"s":254.895975,"e":257.910397,"text":"都是少典的儿子一个居姜水一个居姬水","last":"一个居姬水","type":"kinetic"},{"s":257.910397,"e":261.497404,"text":"所以一个姓姜一个姓姬后来呢后来两个部落打起来了","last":"后来两个部落打起来了","type":"kinetic"},{"s":261.497404,"e":264.430397,"text":"在阪泉打了三仗炎帝输了","last":"炎帝输了","type":"kinetic"},{"s":264.430397,"e":269.71085,"text":"两个部落合并了变成了华夏族再后来他们俩一起在涿鹿跟蚩尤打了一仗","last":"在涿鹿跟蚩尤打了一仗","type":"kinetic"},{"s":269.71085,"e":273.289512,"text":"把蚩尤灭了这就是华夏族的正式形成所以我们叫炎黄子孙","last":"所以我们叫炎黄子孙","type":"slam"},{"s":273.289512,"e":277.6481,"text":"炎就是炎帝黄就是黄帝你想想这个故事背后是什么","last":"这个故事背后是什么","type":"q"},{"s":277.68809999999996,"e":280.480034,"text":"是中国远古时代三个大部落之间的战争与融合","last":"三个大部落之间的战争与融合","type":"kinetic"},{"s":280.480034,"e":284.56640600000003,"text":"神农氏这个部落最早进入农业文明所以最厉害","last":"所以最厉害","type":"kinetic"},{"s":284.56640600000003,"e":287.7486,"text":"但后来黄帝这个部落崛起了在阪泉打败了炎帝","last":"在阪泉打败了炎帝","type":"kinetic"},{"s":287.7886,"e":293.91107700000003,"text":"两个部落合并变成了炎黄部落联盟然后他们一起打败了蚩尤部落统一了中原","last":"统一了中原","type":"slam"},{"s":293.91107700000003,"e":295.032959,"text":"这就是华夏民族的起源","last":"这就是华夏民族的起源","type":"slam"},{"s":295.032959,"e":298.3502,"text":"炎帝为什么叫炎因为他是管火的传说他发明了陶器","last":"传说他发明了陶器","type":"chapter","tag":"第六章","title":"为什么叫炎帝"},{"s":298.3902,"e":302.82865100000004,"text":"对就是你今天吃饭用的碗在陶器之前人煮东西怎么煮","last":"人煮东西怎么煮","type":"q"},{"s":302.82865100000004,"e":306.25613400000003,"text":"把石头烧红了扔到水里把水烧开把食物烫熟","last":"把食物烫熟","type":"kinetic"},{"s":306.25613400000003,"e":312.804274,"text":"神农氏说这多麻烦我用泥巴捏个罐子放到火上烧烧硬了不就能装水了吗","last":"烧硬了不就能装水了吗","type":"slam"},{"s":312.804274,"e":317.54,"text":"于是他发明了陶器你别觉得这有什么了不起的你想想有了陶器人就能煮东西吃了","last":"人就能煮东西吃了","type":"kinetic"},{"s":317.58,"e":320.253866,"text":"煮东西比烤东西好吃而且更容易消化","last":"而且更容易消化","type":"kinetic"},{"s":320.253866,"e":324.15761475409835,"text":"而且陶器能存水存粮有了储存生活就稳定了","last":"生活就稳定了","type":"icon"},{"s":324.15761475409835,"e":327.582846,"text":"因为他发明了火发明了陶器所以后人叫他炎帝","last":"所以后人叫他炎帝","type":"slam"},{"s":329.1,"e":329.938175,"text":"炎就是两个火你今天吃的每一碗米饭","last":"你今天吃的每一碗米饭","type":"chapter","tag":"尾声","title":"与你有关"},{"s":329.938175,"e":336.0695,"text":"都是神农氏七千年前尝出来的你今天去中医馆扎的每一针都是神农氏七千年前发明的","last":"都是神农氏七千年前发明的","type":"kinetic"},{"s":336.10949999999997,"e":339.692052,"text":"你今天去菜市场买的每一把菜都是神农氏七千年前定下的规矩","last":"都是神农氏七千年前定下的规矩","type":"icon"},{"s":339.692052,"e":344.659172,"text":"甚至你今天用的每一个碗都是神农氏七千年前发明的","last":"都是神农氏七千年前发明的","type":"kinetic"},{"s":344.659172,"e":348.108764,"text":"你说你跟他没关系你每天都活在他七千年前的遗产里","last":"你每天都活在他七千年前的遗产里","type":"slam"},{"s":348.108764,"e":350.935726,"text":"我有时候觉得我们这代人特别崇洋媚外","last":"我们这代人特别崇洋媚外","type":"kinetic"},{"s":350.935726,"e":356.67638300000004,"text":"觉得西方什么都好什么科学都是西方传过来的但你想想七千年前当欧洲人还在山洞里画壁画的时候","last":"当欧洲人还在山洞里画壁画的时候","type":"kinetic"},{"s":356.67638300000004,"e":361.59434200000004,"text":"中国人已经在种地了已经在尝百草了已经在搞市场经济了","last":"已经在搞市场经济了","type":"slam"},{"s":361.59434200000004,"e":365.365272,"text":"我们这个文明不是从工业革命开始的我们是从神农氏开始的","last":"我们是从神农氏开始的","type":"slam"},{"s":365.365272,"e":369.37255100000004,"text":"七千年来我们一直在种地一直在治病一直在做买卖","last":"一直在做买卖","type":"kinetic"},{"s":369.37255100000004,"e":372.48580000000004,"text":"中间打了很多仗经历了很多灾难但这些事从来没断过","last":"但这些事从来没断过","type":"kinetic"},{"s":372.5259,"e":376.59128100000004,"text":"这就是为什么中国是世界上唯一没有中断的古文明","last":"这就是为什么中国是世界上唯一没有中断的古文明","type":"slam"},{"s":376.59128100000004,"e":380.272574,"text":"因为我们从神农氏开始就知道怎么种地怎么治病怎么做生意","last":"怎么做生意","type":"kinetic"},{"s":380.272574,"e":383.2765,"text":"这些本事刻在我们骨子里了行不扯远了","last":"不扯远了","type":"slam"},{"s":383.2765,"e":385.47,"text":"我是艾伦遛狗去了白了个白","last":"白了个白","type":"endcard"}],"subs":[[0.02,1.554,"你今天中午吃的米饭"],[1.554,2.129,"白菜"],[2.129,2.509,"萝卜"],[2.509,2.579,"猪肉"],[2.579,4.101,"你每天喝的茶"],[4.101,5.192,"你生病吃的中药"],[5.192,6.058,"这些东西"],[6.058,7.21,"最早是谁发现的"],[7.21,8.651,"不是什么神农架的野人"],[8.651,10.095,"也不是什么修仙的道士"],[10.134,12.382,"是一个距今七千多年的部落首领"],[12.382,13.216,"他叫炎帝"],[13.216,14.135,"也叫神农氏"],[14.135,16.163,"你可能听过神农尝百草的故事"],[16.163,17.233,"说他为了找药"],[17.233,18.988,"一天之内遇到七十二种毒"],[18.988,20.024,"全靠茶解毒"],[20.024,21.248,"听着像神话是吧"],[21.288,22.721,"但我今天要跟你讲的是"],[22.721,23.648,"这个神农氏"],[23.648,24.329,"他干的事"],[24.329,25.6,"比你想象的要大得多"],[25.6,26.799,"他不光尝百草"],[26.799,28.433,"他还教会了中国人种地"],[28.433,29.516,"他还发明了医药"],[29.516,30.861,"他还搞了最早的市场"],[30.861,31.5,"一个人"],[31.5,32.34,"干了四件事"],[32.38,33.218,"每一件事"],[33.218,34.889,"都够别的文明记几百年的"],[34.889,35.969,"在神农氏之前"],[35.969,36.877,"中国人吃什么"],[36.877,37.526,"打猎"],[37.526,38.07,"采集"],[38.07,39.064,"今天逮个兔子"],[39.064,40.163,"明天摘点野果子"],[40.163,41.527,"后天跟老虎打架输了"],[41.527,42.564,"就被老虎吃了"],[42.604,44.814,"这种生活方式有个什么问题"],[44.814,46.214,"不稳定"],[46.214,47.45,"猎物多的时候吃撑"],[47.45,48.443,"猎物少的时候饿死"],[48.443,49.354,"遇到天灾"],[49.354,50.453,"全族团灭"],[50.453,50.578,"神农氏干了什么"],[50.578,51.296,"他发现"],[51.296,52.503,"有些植物的种子"],[52.503,53.246,"掉在地上"],[53.246,55.132,"第二年能长出新的植物来"],[55.132,56.557,"而且这些植物的种子"],[56.557,57.128,"能吃"],[57.128,58.136,"于是他开始试"],[58.136,59.596,"哪种植物的种子能吃"],[59.596,60.986,"哪种植物的果实能吃"],[60.986,62.356,"哪种植物的根能吃"],[62.397,63.458,"他一种一种试"],[63.458,64.556,"试出来能吃的"],[64.556,65.641,"就大面积种植"],[65.641,66.898,"这就是农业的起源"],[66.898,69.138,"你别觉得这有什么了不起的"],[69.138,69.256,"你想想"],[69.256,70.555,"从打猎采集到种地"],[70.555,71.797,"这中间差了什么"],[71.797,72.779,"差了一个文明"],[72.819,73.903,"打猎采集的人"],[73.903,74.776,"天天搬家"],[74.776,75.605,"跟着猎物跑"],[75.605,76.281,"种地的人"],[76.281