# ===== 依赖与缓存 =====
node_modules/
__pycache__/
*.pyc
.venv/
.cache/
*.log
*.pid
*.err

# ===== 第三方运行时（体积大，见独立仓库 DaBaoAgent/gpt-sovits）=====
vendor/
# 020_曹操 目录内是 mg-styles-15 整套环境副本（node_modules/.git/Chrome 缓存），等同 vendor
output/020_曹操/

# ===== 逐帧渲染中间产物（帧序列一律不入库，全前缀覆盖）=====
frames*/
capture_frames/

# ===== 旧工作区产物与临时探测输出 =====
/out/
output/_tmp_*/

# ===== 媒体产物：成片 / 草稿 / 混音均不入库 =====
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.flac
*.m4a

# ===== 临时与探测输出 =====
tmp/
*.tmp
probe/*.png

# ===== 本地密钥 =====
.env
.env.*
*.key
*.pem
