   "海平面一波波往上跳"
  ],
  [
   187.18,
   189.57,
   "最终冲垮了霍尔木兹海峡那座基什山"
  ],
  [
   189.57,
   190.43,
   "海水倒灌整片绿洲"
  ],
  [
   190.43,
   192.92,
   "一夜之间变成了波斯湾"
  ],
  [
   192.92,
   194.95,
   "你再看苏美尔人自己写的创世纪"
  ],
  [
   194.95,
   196.59,
   "众神早知道洪水要来"
  ],
  [
   196.59,
   197.74,
   "自己却被冲得狼狈"
  ],
  [
   197.74,
   199.46,
   "洪水退后还能跟人类生孩子"
  ],
  [
   199.46,
   200.3,
   "说白了"
  ],
  [
   200.3,
   201.91,
   "这众神不就是一群"
  ],
  [
   201.91,
   203.58,
   "科技比人类高一大截的前文明吗"
  ],
  [
   203.58,
   206.49,
   "他们算得出基什山要崩"
  ],
  [
   206.49,
   207.19,
   "算得出大限将至"
  ],
  [
   207.19,
   208.14,
   "但拦不住"
  ],
  [
   208.14,
   209.15,
   "于是开了个会"
  ],
  [
   209.15,
   209.98,
   "决定瞒着人类"
  ],
  [
   209.98,
   211.03,
   "只有智慧之神恩基泄了密"
  ],
  [
   211.03,
   212.69,
   "人类造了方舟逃过一劫"
  ],
  [
   212.69,
   213.82,
   "这段洪水故事"
  ],
  [
   213.82,
   215.71,
   "细节跟圣经几乎一模一样"
  ],
  [
   215.71,
   217.33,
   "却比圣经早了一千多年"
  ],
  [
   217.33,
   218.32,
   "洪水以后"
