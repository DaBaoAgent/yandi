  "subs": [
    {
      "t0": 0,
      "t1": 0.58,
      "text": "一个寡妇",
      "hl": "寡妇"
    },
    {
      "t0": 0.9,
      "t1": 2.42,
      "text": "改写了三国三百年的走向",
      "hl": "三国"
    },
    {
      "t0": 2.42,
      "t1": 3.86,
      "text": "这话听着像标题党",
      "hl": "标题党"
    },
    {
      "t0": 3.86,
      "t1": 5.5,
      "text": "但三国历史最大的拐弯",
      "hl": "三国"
    },
    {
      "t0": 5.5,
      "t1": 7.68,
      "text": "起点可能就是曹操娶了一个寡妇",
      "hl": "寡妇"
    },
    {
      "t0": 7.68,
      "t1": 8.04,
      "text": "那一晚",
      "hl": "那一晚"
    },
    {
      "t0": 8.04,
      "t1": 9.28,
      "text": "官渡赤壁那些大仗都没",
      "hl": "官渡"
    },
    {
      "t0": 9.28,
      "t1": 10.26,
      "text": "这一晚改写得狠",
      "hl": "这一晚"
    },
    {
      "t0": 10.26,
      "t1": 12.5,
      "text": "先说这一晚怎么来的",
      "hl": "这一晚"
    },
    {
      "t0": 12.5,
      "t1": 13.54,
      "text": "宛城那一夜",
      "hl": "宛城"
    },
    {
      "t0": 13.54,
      "t1": 14.64,
      "text": "公元一百九十七年",
      "hl": "公元"
    },
    {
      "t0": 14.64,
      "t1": 15.94,
      "text": "张绣投降了曹操",
      "hl": "张绣"
    },
    {
      "t0": 15.94,
      "t1": 16.7,
      "text": "张绣是谁",
      "hl": "张绣"
    },
    {
      "t0": 16.7,
      "t1": 18.36,
      "text": "西凉军阀张济的侄子",
      "hl": "张济"
    },
    {
      "t0": 18.36,
      "t1": 19.2,
      "text": "张济死了",
      "hl": "张济"
    },
    {
      "t0": 19.2,
      "t1": 20.46,
      "text": "张绣接管了他的部队",
      "hl": "张绣"
    },
    {
      "t0": 20.46,
      "t1": 22.58,
      "text": "曹操兵不血刃收编了一支军队",
      "hl": "兵不血刃"
    },
    {
      "t0": 22.58,
      "t1": 24.2,
      "text": "本来是一桩挺好的收购案",
      "hl": "收购案"
    },
    {
      "t0": 24.2,
      "t1": 25.62,
      "text": "结果曹操看上了",
      "hl": "曹操"
    },
    {
      "t0": 25.62,
      "t1": 26.34,
      "text": "张绣的婶婶",
      "hl": "张绣"
    },
    {
      "t0": 26.34,
      "t1": 27.88,
      "text": "张济的老婆姓邹",
      "hl": "张济"
    },
    {
      "t0": 27.88,
      "t1": 29.32,
      "text": "他直接把人给纳了",
      "hl": "纳"
    },
    {
      "t0": 29.32,
      "t1": 31.14,
      "text": "张绣觉得这是奇耻大辱",
      "hl": "奇耻大辱"
    },
    {
      "t0": 31.14,
      "t1": 32.3,
      "text": "你收编我的部队",
      "hl": "收编"
    },
    {
      "t0": 32.3,
      "t1": 33.62,
      "text": "还要睡我叔叔的老婆",
      "hl": "叔叔"
    },
    {
      "t0": 33.62,
      "t1": 34.6,
      "text": "这谁忍得了",
      "hl": "忍得了"
    },
    {
      "t0": 34.6,
      "t1": 35.88,
      "text": "当晚张绣就反了",
      "hl": "张绣"
    },
    {
      "t0": 35.88,
      "t1": 36.98,
      "text": "偷袭曹操大营",
      "hl": "偷袭"
    },
    {
      "t0": 36.98,
      "t1": 38.54,
      "text": "曹操输得比赤壁还惨",
      "hl": "赤壁"
    },
    {
      "t0": 38.54,
      "t1": 39.76,
      "text": "贴身保镖典韦",
      "hl": "典韦"
    },
    {
      "t0": 39.76,
      "t1": 41.36,
      "text": "一个人堵在营门口",
      "hl": "营门"
    },
    {
      "t0": 41.36,
      "t1": 42.34,
      "text": "扛住张绣的兵",
      "hl": "张绣"
    },
    {
      "t0": 42.34,
      "t1": 43.86,
      "text": "中了几十枪死了",
      "hl": "死"
    },
    {
      "t0": 43.86,
      "t1": 44.34,
      "text": "他死之后",
      "hl": "死"
    },
    {
      "t0": 44.34,
      "t1": 45.62,
      "text": "张绣的兵都不敢",
      "hl": "张绣"
    },
    {
      "t0": 45.62,
      "t1": 46.6,
      "text": "从他尸体前过",
      "hl": "尸体"
    },
    {
      "t0": 46.6,
      "t1": 47.64,
      "text": "大儿子曹昂",
      "hl": "曹昂"
    },
    {
      "t0": 47.64,
      "t1": 49.24,
      "text": "把自己的马让给曹操",
      "hl": "曹操"
    },
    {
      "t0": 49.24,
      "t1": 50.82,
      "text": "曹操的坐骑被流箭射中",
      "hl": "流箭"
    },
    {
      "t0": 50.82,
      "t1": 51.64,
      "text": "跑不动了",
      "hl": "跑不动"
    },
    {
      "t0": 51.64,
      "t1": 52.76,
      "text": "曹昂把马给他",
      "hl": "曹昂"
    },
    {
      "t0": 52.76,
      "t1": 53.86,
      "text": "自己留下断后",
      "hl": "断后"
    },
    {
      "t0": 53.86,
      "t1": 55.02,
      "text": "然后曹昂也死了",
      "hl": "曹昂"
    },
    {
      "t0": 55.02,
      "t1": 55.88,
      "text": "曹操逃出来",
      "hl": "曹操"
    },
    {
      "t0": 55.88,
      "t1": 56.96,
      "text": "哭得不成样子",
      "hl": "哭"
    },
    {
      "t0": 56.96,
      "t1": 58.04,
      "text": "老婆后来也没了",
      "hl": "老婆"
    },
    {
      "t0": 58.04,
      "t1": 59.42,
      "text": "曹昂本来是要接班的",
      "hl": "曹昂"
    },
    {
      "t0": 59.42,
      "t1": 60.2,
      "text": "曹昂是谁",
      "hl": "曹昂"
    },
    {
      "t0": 60.2,
      "t1": 61.46,
      "text": "曹操的嫡长子",
      "hl": "嫡长子"
    },
    {
      "t0": 61.46,
      "t1": 62.28,
      "text": "生母死得早",
      "hl": "死"
    },
    {
      "t0": 62.28,
      "t1": 63.7,
      "text": "是丁夫人把他养大的",
      "hl": "丁夫人"
    },
    {
      "t0": 63.7,
      "t1": 65.22,
      "text": "丁夫人没有亲儿子",
      "hl": "丁夫人"
    },
    {
      "t0": 65.22,
      "t1": 66.54,
      "text": "把曹昂当成命根子",
      "hl": "命根子"
    },
    {
      "t0": 66.54,
      "t1": 68.26,
      "text": "曹操二十岁就开始培养曹昂",
      "hl": "曹昂"
    },
    {
      "t0": 68.26,
      "t1": 69.36,
      "text": "带他上战场",
      "hl": "上战场"
    },
    {
      "t0": 69.36,
      "t1": 70.68,
      "text": "手把手教他怎么带兵",
      "hl": "带兵"
    },
    {
      "t0": 70.68,
      "t1": 72.06,
      "text": "曹操当时四十多岁",
      "hl": "曹操"
    },
    {
      "t0": 72.06,
      "t1": 73.04,
      "text": "曹昂二十岁",
      "hl": "曹昂"
    },
    {
      "t0": 73.04,
      "t1": 73.62,
      "text": "不出意外",
      "hl": ""
    },
    {
      "t0": 73.62,
      "t1": 75.56,
      "text": "曹操的位子就是曹昂的",
      "hl": "曹昂"
    },
    {
      "t0": 75.56,
      "t1": 76.58,
      "text": "曹昂一表人才",
      "hl": "曹昂"
    },
    {
      "t0": 76.58,
      "t1": 77.44,
      "text": "人缘也好",
      "hl": "人缘"
    },
    {
      "t0": 77.44,
      "t1": 79.02,
      "text": "曹操身边的老臣都认他",
      "hl": "老臣"
    },
    {
      "t0": 79.02,
      "t1": 80.88,
      "text": "结果这一夜什么都没了",
      "hl": "一夜"
    },
    {
      "t0": 80.88,
      "t1": 82.32,
      "text": "丁夫人知道曹昂死了",
      "hl": "丁夫人"
    },
    {
      "t0": 82.32,
      "t1": 83,
      "text": "跟曹操闹",
      "hl": "曹操"
    },
    {
      "t0": 83,
      "t1": 84.06,
      "text": "你把我儿子杀了",
      "hl": "儿子"
    },
    {
      "t0": 84.06,
      "t1": 84.9,
      "text": "我还跟你过什么",
      "hl": ""
    },
    {
      "t0": 84.9,
      "t1": 86.4,
      "text": "曹操去求她回来",
      "hl": "曹操"
    },
    {
      "t0": 86.4,
      "t1": 87,
      "text": "她不见",
      "hl": "不见"
    },
    {
      "t0": 87,
      "t1": 88.16,
      "text": "曹操最后一次去",
      "hl": "曹操"
    },
    {
      "t0": 88.16,
      "t1": 89.2,
      "text": "她坐在那织布",
      "hl": "织布"
    },
    {
      "t0": 89.2,
      "t1": 89.78,
      "text": "头都不抬",
      "hl": "不抬"
    },
    {
      "t0": 89.78,
      "t1": 91.1,
      "text": "曹操摸着她的背说",
      "hl": "曹操"
    },
    {
      "t0": 91.1,
      "t1": 92.2,
      "text": "你就不想我了吗",
      "hl": ""
    },
    {
      "t0": 92.2,
      "t1": 93.68,
      "text": "丁夫人还是不回头",
      "hl": "丁夫人"
    },
    {
      "t0": 93.68,
      "t1": 94.88,
      "text": "曹操说行",
      "hl": "曹操"
    },
    {
      "t0": 94.88,
      "t1": 96.02,
      "text": "那咱们真离了",
      "hl": "离"
    },
    {
      "t0": 96.02,
      "t1": 97.58,
      "text": "这段史书写得特别清楚",
      "hl": "史书"
    },
    {
      "t0": 97.58,
      "t1": 99.14,
      "text": "曹操晚年反复念叨",
      "hl": "念叨"
    },
    {
      "t0": 99.14,
      "t1": 101.06,
      "text": "我死之后曹昂要是问我",
      "hl": "曹昂"
    },
    {
      "t0": 101.06,
      "t1": 101.88,
      "text": "他妈妈在哪",
      "hl": "妈妈"
    },
    {
      "t0": 101.88,
      "t1": 102.58,
      "text": "我怎么回答",
      "hl": "回答"
    },
    {
      "t0": 102.58,
      "t1": 104.68,
      "text": "你看一个娶亲的决定",
      "hl": "娶亲"
    },
    {
      "t0": 104.68,
      "t1": 105.74,
      "text": "搭上了儿子的命",
      "hl": "儿子"
    },
    {
      "t0": 105.74,
      "t1": 106.62,
      "text": "老婆也跟他离了",
      "hl": "老婆"
    },
    {
      "t0": 106.62,
      "t1": 107.4,
      "text": "后面的历史",
      "hl": "历史"
    },
    {
      "t0": 107.94,
      "t1": 108.62,
      "text": "全是推演",
      "hl": "推演"
    },
    {
      "t0": 108.62,
      "t1": 109.82,
      "text": "曹昂不死",
      "hl": "曹昂"
    },
    {
      "t0": 109.82,
      "t1": 110.92,
      "text": "后来就轮不到曹丕",
      "hl": "曹丕"
    },
    {
      "t0": 110.92,
      "t1": 112.08,
      "text": "曹昂死后",
      "hl": "曹昂"
    },
    {
      "t0": 112.08,
      "t1": 113.3,
      "text": "曹操在曹丕和曹植之间",
      "hl": "曹丕"
    },
    {
      "t0": 113.3,
      "t1": 114.18,
      "text": "选继承人",
      "hl": "继承人"
    },
    {
      "t0": 114.18,
      "t1": 115.22,
      "text": "选了曹丕",
      "hl": "曹丕"
    },
    {
      "t0": 115.22,
      "t1": 116.44,
      "text": "曹丕逼汉献帝禅让",
      "hl": "曹丕"
    },
    {
      "t0": 116.44,
      "t1": 117.34,
      "text": "当了皇帝",
      "hl": "皇帝"
    },
    {
      "t0": 117.34,
      "t1": 118.18,
      "text": "曹丕传曹叡",
      "hl": "曹丕"
    },
    {
      "t0": 118.18,
      "t1": 120.06,
      "text": "曹叡托孤给曹爽和司马懿",
      "hl": "司马懿"
    },
    {
      "t0": 120.06,
      "t1": 121.46,
      "text": "曹爽是个二世祖",
      "hl": "曹爽"
    },
    {
      "t0": 121.46,
      "t1": 122.9,
      "text": "把司马懿逼得装病十年",
      "hl": "司马懿"
    },
    {
      "t0": 122.9,
      "t1": 123.94,
      "text": "司马懿这人",
      "hl": "司马懿"
    },
    {
      "t0": 123.94,
      "t1": 124.88,
      "text": "你让他装病",
      "hl": "装病"
    },
    {
      "t0": 124.88,
      "t1": 126.04,
      "text": "他就真能躺十年",
      "hl": "躺十年"
    },
    {
      "t0": 126.04,
      "t1": 127.56,
      "text": "他等的就是曹爽犯错",
      "hl": "曹爽"
    },
    {
      "t0": 127.56,
      "t1": 129.36,
      "text": "公元二百四十九年",
      "hl": "公元"
    },
    {
      "t0": 129.36,
      "t1": 130.74,
      "text": "曹爽陪皇帝出城上坟",
      "hl": "曹爽"
    },
    {
      "t0": 130.74,
      "t1": 131.78,
      "text": "高平陵",
      "hl": "高平陵"
    },
    {
      "t0": 131.78,
      "t1": 132.92,
      "text": "司马懿的病突然好了",
      "hl": "司马懿"
    },
    {
      "t0": 132.92,
      "t1": 134.54,
      "text": "一夜之间拿下洛阳",
      "hl": "洛阳"
    },
    {
      "t0": 134.54,
      "t1": 135.32,
      "text": "夺了曹家的权",
      "hl": "曹家"
    },
    {
      "t0": 135.32,
      "t1": 136.34,
      "text": "再往后",
      "hl": "往后"
    },
    {
      "t0": 136.34,
      "t1": 138.48,
      "text": "司马师司马昭司马炎",
      "hl": "司马师"
    },
    {
      "t0": 138.48,
      "t1": 139.58,
      "text": "一步一步",
      "hl": "一步一步"
    },
    {
      "t0": 139.58,
      "t1": 140.34,
      "text": "才有了晋朝",
      "hl": "晋朝"
    },
    {
      "t0": 140.34,
      "t1": 141.96,
      "text": "这条线的起点就在",
      "hl": "起点"
    },
    {
      "t0": 141.96,
      "t1": 142.82,
      "text": "宛城那一夜",
      "hl": "宛城"
    },
    {
      "t0": 142.82,
      "t1": 144.2,
      "text": "如果曹昂活着",
      "hl": "曹昂"
    },
    {
      "t0": 144.2,
      "t1": 145.02,
      "text": "曹丕上不了位",
      "hl": "曹丕"
    },
    {
      "t0": 145.02,
      "t1": 146.14,
      "text": "曹丕没有",
      "hl": "曹丕"
    },
    {
      "t0": 146.14,
      "t1": 147.38,
      "text": "曹叡曹爽都没有",
      "hl": "曹叡"
    },
    {
      "t0": 147.38,
      "t1": 149,
      "text": "司马懿熬的那些人",
      "hl": "司马懿"
    },
    {
      "t0": 149,
      "t1": 149.86,
      "text": "可能全都换了人",
      "hl": "换了人"
    },
    {
      "t0": 149.86,
      "t1": 151.14,
      "text": "他还有没有机会",
      "hl": "机会"
    },
    {
      "t0": 151.14,
      "t1": 151.7,
      "text": "真不好说",
      "hl": "不好说"
    },
    {
      "t0": 151.7,
      "t1": 153.34,
      "text": "当然历史没有如果",
      "hl": "如果"
    },
    {
      "t0": 153.34,
      "t1": 154.34,
      "text": "这段是推演",
      "hl": "推演"
    },
    {
      "t0": 154.34,
      "t1": 155.14,
      "text": "不是史实",
      "hl": "史实"
    },
    {
      "t0": 155.14,
      "t1": 156.16,
      "text": "跟你有什么关系",
      "hl": "关系"
    },
    {
      "t0": 156.16,
      "t1": 156.98,
      "text": "你可能会问",
      "hl": "可能会问"
    },
    {
      "t0": 156.98,
      "t1": 158.44,
      "text": "一个一千八百年前的八卦",
      "hl": "八卦"
    },
    {
      "t0": 158.44,
      "t1": 159.74,
      "text": "八卦跟我有什么关系",
      "hl": "八卦"
    },
    {
      "t0": 159.74,
      "t1": 160.6,
      "text": "关系大了",
      "hl": "关系"
    },
    {
      "t0": 160.6,
      "t1": 161.18,
      "text": "第一",
      "hl": "第一"
    },
    {
      "t0": 161.18,
      "t1": 162.12,
      "text": "人生最贵的东西",
      "hl": "人生"
    },
    {
      "t0": 162.12,
      "t1": 164.02,
      "text": "往往不是你明码标价买的",
      "hl": "明码标价"
    },
    {
      "t0": 164.02,
      "t1": 165.56,
      "text": "是你上头那一瞬间",
      "hl": "上头"
    },
    {
      "t0": 165.56,
      "t1": 166.42,
      "text": "曹操那一夜",
      "hl": "曹操"
    },
    {
      "t0": 166.42,
      "t1": 168.08,
      "text": "在他看来就是娶个媳妇",
      "hl": "媳妇"
    },
    {
      "t0": 168.08,
      "t1": 169.66,
      "text": "在曹昂看来是死",
      "hl": "曹昂"
    },
    {
      "t0": 169.66,
      "t1": 171.2,
      "text": "在司马懿看来是机会",
      "hl": "司马懿"
    },
    {
      "t0": 171.2,
      "t1": 172.66,
      "text": "第二你以为的小事",
      "hl": "小事"
    },
    {
      "t0": 172.66,
      "t1": 174.36,
      "text": "可能是别人人生的分岔路",
      "hl": "分岔路"
    },
    {
      "t0": 174.36,
      "t1": 175.48,
      "text": "你随手一个决定",
      "hl": "随手"
    },
    {
      "t0": 175.48,
      "t1": 177.42,
      "text": "可能在别人那就是一辈子",
      "hl": "一辈子"
    },
    {
      "t0": 177.42,
      "t1": 178.42,
      "text": "历史有时候就像",
      "hl": "历史"
    },
    {
      "t0": 178.42,
      "t1": 179.22,
      "text": "多米诺骨牌",
      "hl": "多米诺骨牌"
    },
    {
      "t0": 179.22,
      "t1": 180.56,
      "text": "你以为只是推倒了一块",
      "hl": "推倒"
    },
    {
      "t0": 180.56,
      "t1": 181.62,
      "text": "其实倒了一整排",
      "hl": "一整排"
    },
    {
      "t0": 181.62,
      "t1": 182.9,
      "text": "曹操推倒的那一块",
      "hl": "推倒"
    },
    {
      "t0": 182.9,
      "t1": 183.78,
      "text": "叫曹昂",
      "hl": "曹昂"
    },
    {
      "t0": 183.78,
      "t1": 184.7,
      "text": "行不扯远了",
      "hl": "扯远"
    },
    {
      "t0": 184.7,
      "t1": 185.28,
      "text": "我是艾伦",
      "hl": "艾伦"
    },
    {
      "t0": 185.28,
      "t1": 185.96,
      "text": "遛狗去了",
      "hl": "遛狗"
    },
    {
      "t0": 185.96,
      "t1": 186.64,
      "text": "拜了个拜",
      "hl": ""
    }
  ],
